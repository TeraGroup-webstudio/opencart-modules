# Локальний шаблон конфігурації для розробника.
# Цей файл не є обов'язковим, якщо в репозиторії є `.env.ftp.shared`
# і ви запускаєте `npm run dev`.

# ======================
# Обов'язкові параметри
# ======================
# URL сайту для live reload (сторінка, яку буде перезавантажувати скрипт).
LIVE_RELOAD_URL=https://your-domain.example

# Хост FTP-сервера.
FTP_HOST=your-ftp-host.example

# Порт FTP-сервера (зазвичай 21).
FTP_PORT=21

# Логін FTP-користувача.
FTP_USER=your-ftp-user

# Пароль FTP-користувача.
FTP_PASSWORD=

# Чи використовувати захищене FTP-з'єднання (true/false).
FTP_SECURE=false

# Базовий шлях на сервері до кореня OpenCart.
FTP_REMOTE_BASE=/path/to/opencart/root

# ======================
# Вотчер і завантаження (локально -> хостинг)
# ======================
# Список шляхів для відстеження змін і завантаження.
# Якщо порожньо, використовуються стандартні шляхи:
# admin,catalog,system,image,index.php,config.php,admin/config.php,.htaccess,.htaccess.txt,robots.txt,sitemap.xml
WATCH_UPLOAD_PATHS=

# Список масок виключень (через кому або новий рядок), підтримується glob-синтаксис.
WATCH_EXCLUDE_PATHS=image/cache/**,image/catalog/product/**,admin/view/stylesheet/bootstrap.css,system/storage/cache/**

# Шляхи для одноразового завантаження під час старту скрипта.
INITIAL_UPLOAD_PATHS=

# Використовувати polling-режим для відстеження файлів (true/false).
WATCH_USE_POLLING=false

# Інтервал polling у мілісекундах.
WATCH_INTERVAL=180

# Затримка (debounce) перед відправкою файлу на сервер у мілісекундах.
UPLOAD_COOLDOWN_MS=100

# ======================
# Стратегія синхронізації
# ======================
# Режим синхронізації контенту:
# push-only     = лише локально -> хостинг
# bidirectional = локально -> хостинг + періодичний pull з хостингу
CONTENT_SYNC_MODE=bidirectional

# Увімкнути періодичне завантаження змін з хостингу (true/false).
REMOTE_PULL_ENABLED=true

# Шляхи на сервері для pull-синхронізації.
REMOTE_PULL_PATHS=admin,catalog,system,image

# Інтервал pull-синхронізації у секундах.
REMOTE_PULL_INTERVAL_SEC=90

# Видаляти локальні файли/папки, якщо їх немає на сервері (true/false).
REMOTE_PULL_DELETE=true

# Часовий буфер (секунди), коли нові/щойно змінені локальні файли не можна видаляти під час pull-prune.
REMOTE_PULL_PRUNE_GRACE_SEC=120

# Завантажувати з сервера лише новіші файли (true/false).
REMOTE_PULL_NEWER_ONLY=true

# ======================
# Захист від перезапису чужих змін
# ======================
# Увімкнути безпечне завантаження: якщо файл на сервері змінився після останньої синхронізації,
# локальний upload цього файлу буде пропущено з повідомленням CONFLICT.
SYNC_SAFE_UPLOAD_ENABLED=true

# Допустима похибка порівняння часу зміни файлу на сервері (мс).
SYNC_SAFE_UPLOAD_TOLERANCE_MS=2000

# ======================
# Автооновлення модифікаторів OpenCart
# ======================
# Автоматично запускати refresh модифікаторів після змін файлів (true/false).
OCMOD_AUTO_REFRESH_ENABLED=true

# Шляхи-маски для запуску refresh (через кому або новий рядок, glob-патерни).
# Якщо порожньо, refresh запускається для будь-якого зміненого файлу з watch-списку.
OCMOD_AUTO_REFRESH_PATHS=system/**,index.php,config.php,.htaccess,catalog/controller/**,catalog/language/**,catalog/model/**,catalog/view/theme/default/template/**

# Затримка між автозапусками refresh у мілісекундах (антиспам при серії збережень).
OCMOD_AUTO_REFRESH_COOLDOWN_MS=1500

# Роут OpenCart для refresh модифікаторів.
OCMOD_REFRESH_ROUTE=marketplace/modification/refresh

# ======================
# Live reload у браузері
# ======================
# Увімкнути live reload у браузері (true/false).
LIVE_RELOAD_ENABLED=true

# Автоматично відкривати браузер при старті (true/false).
LIVE_RELOAD_AUTO_OPEN=true

# Порт Chrome Remote Debugging.
CHROME_DEBUG_PORT=9222

# Явний шлях до `chrome.exe` (залиште порожнім для автовизначення).
CHROME_PATH=

# Шлях до профілю Chrome для збереження сесії між запусками.
CHROME_USER_DATA_DIR=

# ======================
# Додаткова діагностика
# ======================
# Таймаут FTP-операцій у мілісекундах.
FTP_TIMEOUT_MS=30000

# Увімкнути детальні FTP-логи (true/false).
FTP_VERBOSE=false
